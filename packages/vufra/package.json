{
  "name": "vufra",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental native PDF renderer for Node.js with TypeScript types",
  "license": "(MIT OR Apache-2.0)",
  "main": "./dist/index.js",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "require": "./dist/index.js", "default": "./dist/index.js" }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "native/*.node", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": { "node": ">=20" }
}
